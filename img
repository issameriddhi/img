# IMAGE PRACTICAL 1: BASIC IMAGE PROCESSING

import cv2
import matplotlib.pyplot as plt

image = cv2.imread("sample.jpg")

if image is None:
    print("image not found")
else:
    rgb = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)
    gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)
    resized = cv2.resize(image, (200, 200))
    flipped_h = cv2.flip(image, 1)
    flipped_v = cv2.flip(image, 0)

    plt.imshow(rgb)
    plt.title("Original")
    plt.axis("off")
    plt.show()

    cropped = image[50:150, 50:150]
    cv2.imwrite("cropped.jpg", cropped)

    copy = image.copy()
    cv2.rectangle(copy, (50,50), (200,200), (255,0,0), 3)
    cv2.circle(copy, (300,150), 40, (0,255,0), -1)
    cv2.putText(copy, "Hello", (50,30),
                cv2.FONT_HERSHEY_SIMPLEX, 1, (0,0,255), 2)


# IMAGE PRACTICAL 2: HISTOGRAM

