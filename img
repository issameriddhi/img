# IMAGE PRACTICAL 6: HIGH PASS FILTER

import cv2
import numpy as np
import matplotlib.pyplot as plt

image = cv2.imread("sample1.jpg", cv2.IMREAD_GRAYSCALE)

if image is None:
    print("Image not found")
else:
    dft = np.fft.fft2(image)
    dft_shift = np.fft.fftshift(dft)

    rows, cols = image.shape
    crow, ccol = rows // 2, cols // 2

    mask = np.ones((rows, cols), np.uint8)
    radius = 30
    mask[crow-radius:crow+radius,
         ccol-radius:ccol+radius] = 0

    filtered_dft = dft_shift * mask
    inverse_shift = np.fft.ifftshift(filtered_dft)
    high_pass = np.fft.ifft2(inverse_shift)
    high_pass = np.abs(high_pass)

    plt.subplot(1, 2, 1)
    plt.imshow(image, cmap="gray")
    plt.title("Original")
    plt.axis("off")

    plt.subplot(1, 2, 2)
    plt.imshow(high_pass, cmap="gray")
    plt.title("High Pass")
    plt.axis("off")

    plt.tight_layout()
    plt.show()


# IMAGE PRACTICAL 7: DCT TRANSFORMATION

import cv2
import numpy as np
import matplotlib.pyplot as plt

image = cv2.imread("sample1.jpg", cv2.IMREAD_GRAYSCALE)

if image is None:
    print("Image not found")
else:
    image_float = np.float32(image)

    dct_image = cv2.dct(image_float)
    idct_image = cv2.idct(dct_image)

    plt.figure(figsize=(12, 4))

    plt.subplot(1, 3, 1)
    plt.imshow(image, cmap="gray")
    plt.title("Original")
    plt.axis("off")

    plt.subplot(1, 3, 2)
    plt.imshow(np.log(np.abs(dct_image) + 1), cmap="gray")
    plt.title("DCT (log scale)")
    plt.axis("off")

    plt.subplot(1, 3, 3)
    plt.imshow(np.clip(idct_image, 0, 255).astype(np.uint8),
               cmap="gray")
    plt.title("Reconstructed")
    plt.axis("off")

    plt.tight_layout()
    plt.show()


# IMAGE PRACTICAL 8: HADAMARD TRANSFORMATION

import cv2
import numpy as np
import matplotlib.pyplot as plt
from scipy.linalg import hadamard

image = cv2.imread("sample1.jpg", cv2.IMREAD_GRAYSCALE)

if image is None:
    print("Image not found")
else:
    image = cv2.resize(image, (128, 128))
    image = np.float32(image)

    H = hadamard(128)
    H = H / np.sqrt(128)

    transformed = H @ image @ H.T
    reconstructed = H.T @ transformed @ H

    plt.figure(figsize=(12, 4))

    plt.subplot(1, 3, 1)
    plt.imshow(image, cmap="gray")
    plt.title("Original")
    plt.axis("off")

    plt.subplot(1, 3, 2)
    plt.imshow(np.log(np.abs(transformed) + 1), cmap="gray")
    plt.title("Hadamard (log scale)")
    plt.axis("off")

    plt.subplot(1, 3, 3)
    plt.imshow(np.clip(reconstructed, 0, 255).astype(np.uint8),
               cmap="gray")
    plt.title("Reconstructed")
    plt.axis("off")

    plt.tight_layout()
    plt.show()
cv2.destroyAllWindows()
