# VIDEO PRACTICAL 15: CROP VIDEO

import cv2

video = cv2.VideoCapture("sample_video.mp4")

if not video.isOpened():
    print("Video not found")
else:
    while True:
        success, frame = video.read()

        if not success:
            break

        resized = cv2.resize(frame, (640, 360))
        cropped = resized[80:280, 180:460]

        cv2.imshow("Resized Video", resized)
        cv2.imshow("Cropped Region", cropped)

        if cv2.waitKey(25) & 0xFF == ord("q"):
            break

    video.release()
    cv2.destroyAllWindows()


# VIDEO PRACTICAL 16: SMOOTHING FILTERS

import cv2

video = cv2.VideoCapture("sample_video.mp4")

if not video.isOpened():
    print("Video not found")
else:
    while True:
        success, frame = video.read()

        if not success:
            break

        average = cv2.blur(frame, (5, 5))
        gaussian = cv2.GaussianBlur(frame, (5, 5), 0)
        median = cv2.medianBlur(frame, 5)

        cv2.imshow("Original", frame)
        cv2.imshow("Average Filter", average)
        cv2.imshow("Gaussian Filter", gaussian)
        cv2.imshow("Median Filter", median)

        if cv2.waitKey(25) & 0xFF == ord("q"):
            break

    video.release()
    cv2.destroyAllWindows()


# VIDEO PRACTICAL 17: EDGE DETECTION

import cv2

video = cv2.VideoCapture("sample_video.mp4")

if not video.isOpened():
    print("Video not found")
else:
    while True:
        success, frame = video.read()

        if not success:
            break

        gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
        blurred = cv2.GaussianBlur(gray, (5, 5), 0)
        edges = cv2.Canny(blurred, 50, 150)

        cv2.imshow("Original Video", frame)
        cv2.imshow("Edge Detection", edges)

        if cv2.waitKey(25) & 0xFF == ord("q"):
            break

    video.release()
    cv2.destroyAllWindows()

